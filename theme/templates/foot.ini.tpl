[main]
font={{ fonts.mono_family }}:size={{ fonts.mono_size }}
pad=12x10
term=foot

[cursor]
color={{ colors.bg|nohash }} {{ colors.accent|nohash }}

[colors]
alpha=0.96
background={{ colors.bg|nohash }}
foreground={{ colors.text|nohash }}
selection-foreground={{ colors.bg|nohash }}
selection-background={{ colors.accent|nohash }}
regular0={{ colors.surface_alt|nohash }}
regular1={{ colors.danger|nohash }}
regular2={{ colors.ok|nohash }}
regular3={{ colors.warn|nohash }}
regular4=6fa8ff
regular5=c79bff
regular6={{ colors.accent_alt|nohash }}
regular7={{ colors.text|nohash }}
bright0={{ colors.border|nohash }}
bright1=ff8a97
bright2=96e6a8
bright3=ffd57a
bright4=8fbcff
bright5=d9b6ff
bright6=8ae6da
bright7=ffffff
