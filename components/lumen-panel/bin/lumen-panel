#!/bin/sh
# Wrapper for the Lumen panel.
#
# gtk-layer-shell must be loaded *before* libwayland-client, otherwise the
# layer-shell protocol is not registered and the panel opens as a normal
# window. Python's GObject introspection loads libraries lazily, so we
# preload it explicitly (documented upstream for non-C bindings).
lib=$(ldconfig -p 2>/dev/null | awk '/libgtk-layer-shell\.so\.0 /{print $NF; exit}')
if [ -n "$lib" ]; then
    export LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}"
fi
exec python3 -m lumen_panel "$@"
