#!/bin/sh
# lumen-screenshot [area|screen]
# Screenshot via grim (wlr-screencopy) and slurp (layer-shell region picker).
# Saves to ~/Pictures/Screenshots and copies to the Wayland clipboard.
set -eu

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/lumen-$(date +%Y%m%d-%H%M%S).png"

case "${1:-area}" in
    area)
        region=$(slurp -b '#0e122099' -c '#ffb454' -w 2) || exit 0  # cancelled
        grim -g "$region" "$file" ;;
    screen) grim "$file" ;;
    *) echo "usage: lumen-screenshot [area|screen]" >&2; exit 2 ;;
esac

wl-copy < "$file"
notify-send -i "$file" "Screenshot saved" "$file" 2>/dev/null || true
