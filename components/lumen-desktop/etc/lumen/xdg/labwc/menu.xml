<?xml version="1.0" encoding="UTF-8"?>
<!-- Desktop (right-click) menu -->
<openbox_menu>
  <menu id="root-menu" label="">
    <item label="Applications">
      <action name="Execute" command="lumen-launcher"/>
    </item>
    <item label="Terminal">
      <action name="Execute" command="foot"/>
    </item>
    <item label="Files">
      <action name="Execute" command="thunar"/>
    </item>
    <item label="Web Browser">
      <action name="Execute" command="firefox-esr"/>
    </item>
    <separator/>
    <item label="Screenshot (area)">
      <action name="Execute" command="lumen-screenshot area"/>
    </item>
    <item label="Reload desktop configuration">
      <action name="Reconfigure"/>
    </item>
    <separator/>
    <item label="Log out">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
